LIFEGRAPH_HOST=127.0.0.1
LIFEGRAPH_PORT=5000
LIFEGRAPH_DEBUG=false
LIFEGRAPH_DATABASE_PATH=instance/lifegraph.db
# Set a long random value and keep it stable across restarts in deployments.
LIFEGRAPH_SECRET_KEY=
# Set true when the app is served over HTTPS.
LIFEGRAPH_COOKIE_SECURE=false
# Use shared Redis storage for rate limits in multi-process deployments.
LIFEGRAPH_RATE_LIMIT_STORAGE_URI=memory://
# Optional SMTP settings; password-reset links are not delivered until configured.
LIFEGRAPH_MAIL_SERVER=
LIFEGRAPH_MAIL_PORT=587
LIFEGRAPH_MAIL_USERNAME=
LIFEGRAPH_MAIL_PASSWORD=
LIFEGRAPH_MAIL_SENDER=
# Trusted public origin, e.g. https://lifegraph.example.org
LIFEGRAPH_PUBLIC_URL=
# New files default to backend/instance/uploads (outside the public static folder).
LIFEGRAPH_UPLOAD_DIRECTORY=
